APP_NAME=AI.SPIRE G2-T1 Vehicle Manual RAG
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aispire_db
POSTGRES_USER=aispire
POSTGRES_PASSWORD=aispire
DATABASE_URL=postgresql://aispire:aispire@postgres:5432/aispire_db

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=vehicle_manuals_ar

OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=180

EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_ENABLED=true

RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RERANKER_TOP_K=5
MIN_RELEVANCE_SCORE=0.05

NEXT_PUBLIC_API_URL=http://localhost:8000

# --- JWT settings ------------------
SECRET_KEY=b7cf139f3e192b50bd62a617e7264a2a9d12126c5f287e469fa76c04f0b0fd54
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS = 7
PASSWORD_HASH_SCHEME=bcrypt
