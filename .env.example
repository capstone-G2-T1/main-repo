# --- General -------------------
ENVIRONMENT=development
DEBUG=true

# --- Postgres ------------------
POSTGRES_USER=aispire
POSTGRES_PASSWORD=aispire
POSTGRES_DB=aispire_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aispire:aispire@postgres:5432/aispire_db

# --- Chroma --------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- Ollama --------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Backend -------------------
BACKEND_PORT=8000

# --- Frontend ------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- JWT settings ------------------
SECRET_KEY=your-very-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256